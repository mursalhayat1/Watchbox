# ── Watchbox Model Context Protocol (MCP) Server Configuration ───────────────

# The URL of your Supabase database containing Watchbox data
# (matches VITE_SUPABASE_URL in root .env)
MCP_SUPABASE_URL=https://hveckbndlnkokfgzrztn.supabase.co

# Supabase Anon / Publishable key
# (matches VITE_SUPABASE_ANON_KEY in root .env)
MCP_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# TMDB API Key for metadata fetching, poster paths, and discover searches
# (matches VITE_TMDB_API_KEY in root .env)
TMDB_API_KEY=your-tmdb-api-key-here

# Network port for MCP server (default: 3001)
MCP_PORT=3001

# Network host binding (default: 0.0.0.0 for all interfaces, or 127.0.0.1 for local only)
MCP_HOST=0.0.0.0

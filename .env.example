# Existing Watchbox Supabase project (browser-safe anon key only; never use a service-role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-browser-safe-anon-key

# TMDB API key used by the existing Watchbox movie/TV metadata integration
TMDB_API_KEY=your-tmdb-api-key

# Set after public deployment to the exact canonical HTTPS origin (no path or trailing slash)
MCP_PUBLIC_URL=https://your-watchbox-domain.example

# Comma-separated OAuth client IDs. The server fails closed if the read list is empty;
# writes are denied unless the client ID is in both lists.
MCP_READ_CLIENT_IDS=
MCP_WRITE_CLIENT_IDS=

# OpenCode MCP client ID, used by the local server as the read allowlist.
# Register a public client in Supabase Dashboard -> Authentication -> OAuth Apps
# with the exact redirect URI http://127.0.0.1:19876/callback. During local
# development this ID is used when MCP_READ_CLIENT_IDS is empty. Add it to
# MCP_WRITE_CLIENT_IDS only for writes. The same public client ID is configured
# in opencode.json; it is an identifier, not a secret.
WATCHBOX_MCP_CLIENT_ID=

# The platform sets PORT in production. Local MCP Inspector development uses 8787 by default.
